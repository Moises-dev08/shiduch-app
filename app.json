{
  "expo": {
    "name": "Zivug Mishamayim",
    "slug": "shiduchim-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo-stores.png",
    "scheme": "shiduchimapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zivugmishamayim",
      "associatedDomains": [
        "applinks:www.zivugmishamayim.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Zivug Mishamayim to access your photo library to upload a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Allow Zivug Mishamayim to save photos to your library.",
        "NSUserNotificationsUsageDescription": "Allow Zivug Mishamayim to send you notifications about new matches, introductions, and messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1235C8",
        "foregroundImage": "./logo-stores.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zivugmishamayim",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.zivugmishamayim.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "zivugmishamayim.com",
              "pathPrefix": "/profile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./logo-stores.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./logo-original.png",
          "imageWidth": 380,
          "resizeMode": "contain",
          "backgroundColor": "#1235C8",
          "dark": {
            "backgroundColor": "#0D1F8A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zivug Mishamayim to access your photo library to upload a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./zm-logo.jpg",
          "color": "#1599D4",
          "defaultChannel": "default",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "privacyPolicyUrl": "https://zivugmishamayim.com/privacy",
      "eas": {
        "projectId": "c6f5ce51-10fc-4c03-9059-63cb696335a3"
      }
    },
    "owner": "moisholino"
  }
}
