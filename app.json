{
  "expo": {
    "name": "Zivug Mishamayim",
    "slug": "shiduchim-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo-stores.png",
    "scheme": "shiduchimapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zivugmishamayim",
      "associatedDomains": ["applinks:www.zivugmishamayim.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1235C8",
        "foregroundImage": "./logo-stores.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zivugmishamayim",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.zivugmishamayim.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "zivugmishamayim.com",
              "pathPrefix": "/profile"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./logo-stores.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./logo-original.png",
          "imageWidth": 380,
          "resizeMode": "contain",
          "backgroundColor": "#1235C8",
          "dark": {
            "backgroundColor": "#0D1F8A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./zm-logo.jpg",
          "color": "#1599D4",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6f5ce51-10fc-4c03-9059-63cb696335a3"
      }
    },
    "owner": "moisholino"
  }
}
