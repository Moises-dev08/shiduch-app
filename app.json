{
  "expo": {
    "name": "Zivug Mishamayim",
    "slug": "shiduchim-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./zm-logo.jpg",
    "scheme": "shiduchimapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zivugmishamayim",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1235C8",
        "foregroundImage": "./zm-logo.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zivugmishamayim"
    },
    "web": {
      "output": "static",
      "favicon": "./zm-logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./logo-original.png",
          "imageWidth": 380,
          "resizeMode": "contain",
          "backgroundColor": "#1235C8",
          "dark": {
            "backgroundColor": "#0D1F8A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./zm-logo.jpg",
          "color": "#1599D4",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6f5ce51-10fc-4c03-9059-63cb696335a3"
      }
    },
    "owner": "moisholino"
  }
}
