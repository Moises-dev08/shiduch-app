{
  "expo": {
    "name": "Zivug Mishamayim",
    "slug": "shiduchim-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo-original.png",
    "scheme": "shiduchimapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zivugmishamayim",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1293DA",
        "foregroundImage": "./logo-original.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./logo-original.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./logo-original.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#1293DA",
          "dark": {
            "backgroundColor": "#0d3b8e"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./logo-original.png",
          "color": "#1293DA",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fcfce1b-d042-4623-a816-1efb1c6dc774"
      }
    },
    "owner": "moisholino"
  }
}
